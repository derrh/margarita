{
  "name": "margarita",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @margarita/web dev",
    "build": "pnpm -r build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @margarita/web test",
    "deploy": "pnpm --filter @margarita/web deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
